# ASR provider: sarvam (default — best for Indian languages) or groq (Whisper)
ASR_PROVIDER=sarvam

# Sarvam AI key: https://dashboard.sarvam.ai — used when ASR_PROVIDER=sarvam
SARVAM_API_KEY=
# saaras:v3 (recommended) or saarika:v2.5
SARVAM_ASR_MODEL=saaras:v3
# translate = English output from Indic speech (best for form-fill);
# transcribe = original language/script (saaras:v3 only)
SARVAM_ASR_MODE=translate

# Groq key (free tier): https://console.groq.com — used for ASR fallback and default LLM
GROQ_API_KEY=

# Extraction LLM provider: groq (default) or openai
LLM_PROVIDER=groq
OPENAI_API_KEY=

# Optional bearer token auth (standalone FastAPI mode only).
FILLY_AUTH_TOKEN=

# Public URL of this server (used to build upload_url handed to the SDK)
PUBLIC_BASE_URL=http://localhost:8090

# Set to 1 to run without any API keys (fake transcript + extraction)
FILLY_MOCK=0
